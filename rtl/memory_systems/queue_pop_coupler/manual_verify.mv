    function automatic int queue_pop_coupler_RESERVOIR_BACKPRESSURE_ENTRIES(int SPOOL_UP, int SPOOL_DOWN);
        // following reservoir formula: (spool up cycles + spool down cycles - 1)
        return (SPOOL_UP + SPOOL_DOWN - 1);
    endfunction
