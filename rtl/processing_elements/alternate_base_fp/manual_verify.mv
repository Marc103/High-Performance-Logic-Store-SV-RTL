    always@(posedge clk_i) begin
        a_sign     <= a_sign_i;
        a_exponent <= a_exponent_i;
        a_mantissa <= a_mantissa_i;

        b_sign     <= b_sign_i;
        b_exponent <= b_exponent_i;
