"
    localparam LATENCY                      = equal_tree_LATENCY                     (REGISTERED_IN, GROUPS, REDUCTION_TREE_LATENCY)
"
- defined as
"
    function automatic int equal_tree_LATENCY(int REGISTERED_IN, int GROUPS, int REDUCTION_TREE_LATENCY);
        int latency = 0;
        if(REGISTERED_IN == 1) latency++;
        if(GROUPS > 1) begin
            latency += REDUCTION_TREE_LATENCY;
        end 
        return latency;
    endfunction
"
- if registered in, adds a cycle
- 'GROUPS' tells us whether a reduction tree afterwards is necessary
    - if GROUPS = 1, that means no further processing needed
    - if GROUPS is greater than 1, that means the reduction tree is added
      afterwards, hence we add the REDUCTION_TREE_LATENCY aswell.
[Marc103 + Codex 5.6 - 09/15/26]

"
    input clk_i,

    input [DATA_WIDTH - 1 : 0] data_a_i,
    input [DATA_WIDTH - 1 : 0] data_b_i,

    output eq_o
"
- signals present
- bit widths are correct 
[Marc103 + Codex 5.6 - 09/15/26]

"
    logic [DATA_WIDTH - 1 : 0] data_a;
    logic [DATA_WIDTH - 1 : 0] data_b;

    logic [DATA_WIDTH - 1 : 0] data_a_g;
    logic [DATA_WIDTH - 1 : 0] data_b_g;

    always@(posedge clk_i) begin
        data_a <= data_a_i;
        data_b <= data_b_i;
    end

    assign data_a_g = (REGISTERED_IN == 1) ? data_a : data_a_i;
    assign data_b_g = (REGISTERED_IN == 1) ? data_b : data_b_i;
"
- standard REGISTERED_IN procedure
[Marc103 + Codex 5.6 - 09/15/26]

"
    ////////////////////////////////////////////////////////////////
    // Stage 1
    logic [PADDED_WIDTH - 1 : 0] data_a_g_padded;
    logic [PADDED_WIDTH - 1 : 0] data_b_g_padded;
    always_comb begin
        data_a_g_padded = 0;
        data_b_g_padded = 0;
        data_a_g_padded[DATA_WIDTH - 1 : 0] = data_a_g;
        data_b_g_padded[DATA_WIDTH - 1 : 0] = data_b_g;
    end

    logic [GROUPS - 1 : 0] compared;
    always_comb begin
        for(int g = 0; g < GROUPS; g++) begin
            compared[g] = data_a_g_padded[(g * LUTX_HALF_GRADED) +: LUTX_HALF_GRADED] ==
                          data_b_g_padded[(g * LUTX_HALF_GRADED) +: LUTX_HALF_GRADED] ? 1 : 0;
        end
    end
"
- declare data_*_g_padded using PADDED_WIDTH 
    - default value is fist set to 0, this fills in partial groups with the same values, ensuring
      compared bits of the filled values will always return true for equals
    - then we set the actually existing bits using [DATA_WIDTH - 1 : 0] range.
- declare compared using GROUPS, as that is how many compare groups we will end up with
- from previous steps, we know each group is LUTX_HALF_GRADED bits wide
    - since g is a procedural loop variable, an indexed part-select is required
    - the start index is '(g * LUTX_HALF_GRADED)'
    - '+: LUTX_HALF_GRADED' selects LUTX_HALF_GRADED bits upward from that start index
    - where g goes from 0 -> GROUPS (exclusive)
    - compared[g] to the result of the equal
[Marc103 + Codex 5.6 - 09/15/26]

"
    ////////////////////////////////////////////////////////////////
    // Stage 2+
    logic eq;
    generate
        if(GROUPS > 1) begin
            reduction_tree #(
                .DATA_WIDTH(GROUPS),
                .GATE(0),
                .REGISTERED_IN(1),
                .LUTX(LUTX),
                .GRADE(GRADE)
            ) and_r_tree (
                .clk_i(clk_i),
                .data_i(compared),
                .reduced_o(eq)
            );
        end
    endgenerate

    assign eq_o = GROUPS > 1 ? eq : compared[0];
"
- same as before, if GROUPS > 1 is when we need a reduction tree, where we do AND reduction of
 'compared'
- check io, parameterization
- final assign uses reduction tree output only if GROUPS > 1, otherwise it uses compared[0] directly.
